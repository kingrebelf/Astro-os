[Desktop Entry]
Type=Application
Name=Text Editor
GenericName=Text Editor
Comment=Edit text files (FeatherPad with the ASTRO look)
Exec=/opt/astro-os/astroctl launch edit %F
Icon=featherpad
Terminal=false
Categories=Utility;TextEditor;
MimeType=application/javascript;application/json;application/sql;application/toml;application/x-desktop;application/xml;application/x-perl;application/x-php;application/x-ruby;application/x-shellscript;application/x-subrip;application/x-yaml;application/x-zerosize;application/yaml;text/css;text/csv;text/javascript;text/markdown;text/plain;text/rust;text/tab-separated-values;text/x-c++hdr;text/x-c++src;text/x-chdr;text/x-cmake;text/x-csrc;text/x-diff;text/x-go;text/x-java;text/x-log;text/x-makefile;text/x-markdown;text/xml;text/x-patch;text/x-python;text/x-readme;text/x-sql;text/x-tex;text/x-toml;text/x-yaml;
