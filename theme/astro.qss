/* ASTRO//OS widget theme for Qt apps (file manager, task manager, settings) */
* { font-family: "Ubuntu Mono"; font-size: 14px; }
QWidget { background-color: #020b07; color: #9dffd0; selection-background-color: #00ff8c; selection-color: #000000; outline: 0; }
QMainWindow, QDialog { background-color: #010705; }
QToolTip { background-color: #001a10; color: #dcfff0; border: 1px solid #00ff8c; padding: 3px; }

QMenuBar { background-color: #010705; border-bottom: 1px solid #0b4d33; }
QMenuBar::item { padding: 5px 12px; background: transparent; }
QMenuBar::item:selected, QMenuBar::item:pressed { background-color: #00ff8c; color: #000000; }
QMenu { background-color: #010905; border: 1px solid #00ff8c; padding: 4px; }
QMenu::item { padding: 6px 26px 6px 22px; }
QMenu::item:selected { background-color: #00ff8c; color: #000000; }
QMenu::item:disabled { color: #1f7350; }
QMenu::separator { height: 1px; background: #0b4d33; margin: 4px 8px; }

QToolBar { background-color: #010705; border: none; border-bottom: 1px solid #0b4d33; spacing: 3px; padding: 3px; }
QToolButton { background: transparent; border: 1px solid transparent; padding: 4px; color: #9dffd0; }
QToolButton:hover { border: 1px solid #00ff8c; background-color: #00331f; }
QToolButton:pressed, QToolButton:checked { background-color: #00ff8c; color: #000000; }

QPushButton { background-color: #021a10; border: 1px solid #00ff8c; padding: 6px 16px; color: #00ff8c; min-height: 16px; }
QPushButton:hover { background-color: #00472a; color: #dcfff0; }
QPushButton:pressed, QPushButton:default:pressed { background-color: #00ff8c; color: #000000; }
QPushButton:default { border: 2px solid #00e5ff; }
QPushButton:disabled { border-color: #0b4d33; color: #1f7350; }

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QAbstractSpinBox {
  background-color: #000000; border: 1px solid #0b4d33; padding: 4px 6px; color: #00ff8c; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border: 1px solid #00ff8c; }
QComboBox::drop-down { border-left: 1px solid #0b4d33; width: 20px; }
QComboBox QAbstractItemView { background-color: #010905; border: 1px solid #00ff8c; }

QTreeView, QListView, QTableView, QColumnView { background-color: #010705; alternate-background-color: #03110b;
  border: 1px solid #0b4d33; gridline-color: #062a1b; }
QTreeView::item, QListView::item, QTableView::item { padding: 3px; }
QTreeView::item:hover, QListView::item:hover, QTableView::item:hover { background-color: #00331f; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected { background-color: #00ff8c; color: #000000; }
QHeaderView::section { background-color: #021a10; color: #00e5ff; border: none; border-right: 1px solid #0b4d33;
  border-bottom: 1px solid #00ff8c; padding: 5px 8px; font-weight: bold; }
QTableCornerButton::section { background-color: #021a10; border: none; }

QTabWidget::pane { border: 1px solid #0b4d33; top: -1px; }
QTabBar::tab { background-color: #010705; border: 1px solid #0b4d33; padding: 6px 14px; color: #2f8a62; }
QTabBar::tab:selected { background-color: #00331f; color: #dcfff0; border: 1px solid #00ff8c; border-bottom: 2px solid #00ff8c; }
QTabBar::tab:hover { color: #00ff8c; }

QScrollBar:vertical { background: #010705; width: 10px; margin: 0; }
QScrollBar:horizontal { background: #010705; height: 10px; margin: 0; }
QScrollBar::handle { background: #0b6b45; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #00ff8c; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

QStatusBar { background-color: #010705; border-top: 1px solid #00ff8c; color: #00e5ff; }
QStatusBar::item { border: none; }
QSplitter::handle { background-color: #0b4d33; }
QSplitter::handle:hover { background-color: #00ff8c; }
QGroupBox { border: 1px solid #0b4d33; margin-top: 12px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 6px; color: #00e5ff; }
QLabel { background: transparent; }
QCheckBox, QRadioButton { background: transparent; spacing: 8px; }
QCheckBox::indicator, QRadioButton::indicator { width: 13px; height: 13px; border: 1px solid #00ff8c; background: #000000; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #00ff8c; border: 3px solid #000000; outline: 1px solid #00ff8c; }
QRadioButton::indicator { border-radius: 7px; }
QProgressBar { border: 1px solid #0b4d33; background: #000000; text-align: center; color: #dcfff0; }
QProgressBar::chunk { background-color: #00ff8c; width: 6px; margin: 1px; }
QSlider::groove:horizontal { height: 4px; background: #0b4d33; }
QSlider::handle:horizontal { background: #00ff8c; width: 10px; margin: -6px 0; }
QDockWidget::title { background: #021a10; padding: 4px; }
QAbstractScrollArea { border: 1px solid #0b4d33; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #0b4d33; }
