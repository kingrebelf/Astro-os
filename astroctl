#!/bin/bash
# ASTRO//OS mode switch.   astroctl on | off | toggle | restart | status | launch <term|web|files|globe> | demo
ROOT=$(dirname "$(readlink -f "$0")")
. "$ROOT/tools/env.sh"
STATE="${XDG_RUNTIME_DIR:-/tmp}/astro-os"
CONF="$HOME/.config/astro-os"
MARK="astro-os-managed"
mkdir -p "$STATE" "$CONF"

session() { gdbus call --session --dest org.lxqt.session --object-path /LXQtSession \
              --method "org.lxqt.session.$1" "$2" >/dev/null 2>&1; }

alive() { [ -f "$STATE/$1.pid" ] && kill -0 "$(cat "$STATE/$1.pid")" 2>/dev/null; }

start_part() {   # name [args...]
  local name=$1; shift
  alive "$name" && return
  XCURSOR_THEME=AstroOS XCURSOR_SIZE=24 setsid python3 "$ROOT/$name.py" "$@" \
      >"$STATE/$name.log" 2>&1 < /dev/null &
  echo $! > "$STATE/$name.pid"
}

stop_part() {
  alive "$1" && kill "$(cat "$STATE/$1.pid")" 2>/dev/null
  pkill -f "python3 $ROOT/$1.py" 2>/dev/null
  rm -f "$STATE/$1.pid"
}

set_session_cursor() {   # theme name, or empty to remove our override
  python3 - "$1" <<'PY'
import os, re, sys
path = os.path.expanduser("~/.config/lxqt/session.conf")
theme = sys.argv[1]
try:
    text = open(path).read()
except OSError:
    text = ""
text = re.sub(r"\n?\[Mouse\]\ncursor_theme=AstroOS\ncursor_size=24\n?", "\n", text).rstrip("\n") + "\n"
if theme:
    text += "\n[Mouse]\ncursor_theme=AstroOS\ncursor_size=24\n"
os.makedirs(os.path.dirname(path), exist_ok=True)
open(path, "w").write(text)
PY
}

apply_theme() {
  # window borders / title bars
  mkdir -p "$HOME/.config/openbox"
  local rc="$HOME/.config/openbox/rc.xml" src=""
  if [ ! -e "$rc" ] || grep -q "$MARK" "$rc"; then
    IFS=: read -ra dirs <<< "${XDG_CONFIG_DIRS:-/etc/xdg}"
    for d in "${dirs[@]}"; do [ -f "$d/openbox/rc.xml" ] && { src="$d/openbox/rc.xml"; break; }; done
    [ -n "$src" ] && python3 - "$src" "$rc" "$MARK" <<'PY'
import re, sys
s = open(sys.argv[1]).read()
s = re.sub(r"(<theme>.*?<name>)[^<]*(</name>)", r"\1AstroOS\2", s, count=1, flags=re.S)
s = re.sub(r"<name>Ubuntu[^<]*</name>", "<name>Ubuntu Mono</name>", s)
# title-bar drags become outline drags (mover.py): moving whole windows floods the slow video chip
s = re.sub(r'(<context name="Titlebar">\s*<mousebind button="Left" action="Drag">\s*)<action name="Move"/>',
           "\\1<action name=\"Execute\"><command>sh -c 'kill -USR1 $(cat $XDG_RUNTIME_DIR/astro-os/mover.pid)'</command></action>", s, count=1)
s = re.sub(r"<drawContents>\s*yes\s*</drawContents>", "<drawContents>no</drawContents>", s)
s = s.replace("?>", f"?>\n<!-- {sys.argv[3]}: generated by ASTRO//OS, removed when you exit it -->", 1)
open(sys.argv[2], "w").write(s)
PY
  fi
  # cursor
  if [ ! -e "$HOME/.icons/default/index.theme" ] || grep -q "$MARK" "$HOME/.icons/default/index.theme"; then
    mkdir -p "$HOME/.icons/default"
    printf '# %s\n[Icon Theme]\nInherits=AstroOS\n' "$MARK" > "$HOME/.icons/default/index.theme"
  fi
  printf 'Xcursor.theme: AstroOS\nXcursor.size: 24\n' | xrdb -merge
  xsetroot -xcf "$HOME/.icons/AstroOS/cursors/left_ptr" 24
  set_session_cursor AstroOS
  # dark neon palette for every Qt app (file manager, task manager, settings...)
  [ -e "$CONF/lxqt.conf.orig" ] || cp "$HOME/.config/lxqt/lxqt.conf" "$CONF/lxqt.conf.orig" 2>/dev/null
  cp "$ROOT/theme/lxqt.conf" "$HOME/.config/lxqt/lxqt.conf"
  firefox_theme
}

firefox_theme() {   # Firefox reads these at its next start
  local base="$HOME/snap/firefox/common/.mozilla/firefox" prof
  [ -d "$base" ] || base="$HOME/.mozilla/firefox"
  for prof in "$base"/*.default*; do
    [ -d "$prof" ] || continue
    mkdir -p "$prof/chrome"
    for f in userChrome.css userContent.css; do
      if [ ! -e "$prof/chrome/$f" ] || grep -q "$MARK" "$prof/chrome/$f"; then cp "$ROOT/theme/firefox/$f" "$prof/chrome/$f"; fi
    done
    if [ ! -e "$prof/user.js" ] || grep -q "$MARK" "$prof/user.js"; then cp "$ROOT/theme/firefox/user.js" "$prof/user.js"; fi
  done
}

remove_theme() {
  local rc="$HOME/.config/openbox/rc.xml"
  [ -e "$rc" ] && grep -q "$MARK" "$rc" && rm -f "$rc"
  local idx="$HOME/.icons/default/index.theme"
  [ -e "$idx" ] && grep -q "$MARK" "$idx" && rm -rf "$HOME/.icons/default"
  xrdb -query | grep -v '^Xcursor\.' | xrdb -load
  xsetroot -cursor_name left_ptr
  set_session_cursor ""
  if [ -e "$CONF/lxqt.conf.orig" ]; then mv "$CONF/lxqt.conf.orig" "$HOME/.config/lxqt/lxqt.conf"; fi
}

on() {
  [ -d "$HOME/.icons/AstroOS" ] || python3 "$ROOT/theme/build.py" >/dev/null
  touch "$CONF/enabled"
  apply_theme
  session stopModule lxqt-panel.desktop
  session stopModule lxqt-desktop.desktop
  session stopModule picom.desktop
  pkill -x picom     # no compositor here: it more than doubles drawing cost on the onboard video chip
  XCURSOR_THEME=AstroOS XCURSOR_SIZE=24 openbox --restart
  start_part mover
  start_part desktop "$@"
  sleep 0.4
  start_part dock
}

off() {
  rm -f "$CONF/enabled"
  stop_part avatar; stop_part mover; stop_part dock; stop_part desktop
  python3 "$ROOT/overlay.py" reset 2>/dev/null
  remove_theme
  pkill -x picom; sleep 0.3
  session startModule picom.desktop
  session startModule lxqt-desktop.desktop
  session startModule lxqt-panel.desktop
  openbox --restart
}

install() {   # one-time setup for this account: theme assets, menu entry, login hook, PATH link
  python3 "$ROOT/theme/build.py"
  mkdir -p "$HOME/.local/share/applications" "$HOME/.config/autostart" "$HOME/.local/bin" "$HOME/Desktop"
  printf '[Desktop Entry]\nType=Application\nName=ASTRO//OS\nComment=Enter the ASTRO//OS desktop\nExec=%s on\nIcon=utilities-terminal\nTerminal=false\nCategories=System;\n' \
      "$ROOT/astroctl" > "$HOME/.local/share/applications/astro-os.desktop"
  cp "$HOME/.local/share/applications/astro-os.desktop" "$HOME/Desktop/astro-os.desktop"
  chmod +x "$HOME/Desktop/astro-os.desktop"
  printf '[Desktop Entry]\nType=Application\nName=ASTRO//OS autostart\nComment=Re-enter ASTRO//OS at login if it was on when you left\nExec=%s autostart\nTerminal=false\nNoDisplay=true\n' \
      "$ROOT/astroctl" > "$HOME/.config/autostart/astro-os.desktop"
  ln -sf "$ROOT/astroctl" "$HOME/.local/bin/astroctl"
  echo "installed for $USER"
}

case "$1" in
  install) install ;;
  on)      shift; on "$@" ;;
  off)     off ;;
  toggle)  if alive desktop; then off; else on; fi ;;
  restart) stop_part avatar; stop_part mover; stop_part dock; stop_part desktop; sleep 0.3
           start_part mover; start_part desktop; sleep 0.4; start_part dock ;;
  autostart) [ -e "$CONF/enabled" ] && { sleep 4; on; } ;;
  status)  for p in desktop dock mover; do alive $p && echo "$p: running" || echo "$p: stopped"; done
           [ -e "$CONF/enabled" ] && echo "starts at login: yes" || echo "starts at login: no" ;;
  launch)
    export XCURSOR_THEME=AstroOS XCURSOR_SIZE=24
    case "$2" in
      term)  exec alacritty --config-file "$ROOT/term/alacritty.toml" -e bash --rcfile "$ROOT/term/bashrc" ;;
      web)   if command -v firefox >/dev/null; then exec firefox; else exec falkon; fi ;;
      files) shift 2; exec python3 "$ROOT/files.py" "$@" ;;
      tasks) exec python3 "$ROOT/taskman.py" ;;
      settings) exec lxqt-config -stylesheet "$ROOT/theme/astro.qss" ;;
      globe) exec python3 "$ROOT/netglobe.py" ;;
    esac ;;
  *) echo "usage: astroctl install|on|off|toggle|restart|status|launch <term|web|files|globe>"; exit 1 ;;
esac
